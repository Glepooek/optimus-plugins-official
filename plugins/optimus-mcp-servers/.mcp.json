{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "avalonia-docs": {
      "type": "http",
      "url": "https://docs-mcp.avaloniaui.net/mcp"
    },
    "mastergo-magic-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mastergo/magic-mcp",
        "--token=<MG_MCP_TOKEN>",
        "--url=https://mastergo.com"
      ],
      "env": {
        "MG_MCP_TOKEN": "${MG_MCP_TOKEN}"
      }
    },
    "FeishuProjectMcp": {
      "command": "npx",
      "args": [
        "-y",
        "@lark-project/mcp",
        "--domain",
        "https://project.feishu.cn"
      ],
      "env": {
        "MCP_USER_TOKEN": "${MCP_USER_TOKEN}"
      }
    }
  }
}
