{
  "env_vars": {
    "GITHUB_TOKEN": "GitHub Copilot MCP 鉴权（Bearer）",
    "MG_MCP_TOKEN": "MasterGo API token（服务原生环境变量）",
    "MCP_USER_TOKEN": "飞书项目 user_token"
  },
  "servers": {
    "github": {
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "bearer": "GITHUB_TOKEN"
    },
    "mastergo-magic-mcp": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mastergo/magic-mcp",
        "--token=<MG_MCP_TOKEN>",
        "--url=https://mastergo.com"
      ],
      "env": ["MG_MCP_TOKEN"]
    },
    "FeishuProjectMcp": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@lark-project/mcp",
        "--domain",
        "https://project.feishu.cn"
      ],
      "env": ["MCP_USER_TOKEN"]
    }
  }
}
